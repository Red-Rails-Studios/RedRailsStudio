package de.gts.redrail.game.models.entities;

import lombok.Data;
import lombok.NoArgsConstructor

@Data
@NoArgsConstructor

public class Map {
 private List<List<Field>> map;

 public Map() {
  for (int x = 0; x < 40; x++) {
    map.add(new ArrayList<>());

    for (inr y = 0; y < 40; y++) {
        map.get(x).add(new ArrayList<>());  
        map.get(x).get(y).add(new Field());
    }
  }
 }
}   
 